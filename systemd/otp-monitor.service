[Unit]
Description=OTP Relay Monitor (phone watcher + alert forwarder)
After=network.target otp-relay.service
Wants=otp-relay.service

[Service]
Type=simple
User=otprelay
WorkingDirectory=/opt/otp-relay
EnvironmentFile=/opt/otp-relay/.env
ExecStart=/opt/otp-relay/venv/bin/python3 monitor.py
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/otp-relay/data

[Install]
WantedBy=multi-user.target
