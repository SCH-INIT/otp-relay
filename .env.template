# OTP Relay — Environment Configuration
# Copy to .env and fill in your values.
# Never commit .env to git or share it.

# ── Security ──────────────────────────────────────────────────────────────────
# Random string — paste this exact value into your iPhone Shortcut header
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SMS_SECRET_TOKEN=replace-with-a-long-random-string

# ── Exchange SMTP (ask IT for these) ──────────────────────────────────────────
# Internal Exchange server hostname or IP
SMTP_HOST=mail.company.local

# 587 = STARTTLS (recommended), 25 = plain, 465 = SSL
SMTP_PORT=587

# The dedicated relay account IT will create for you
SMTP_USER=otp-relay@company.com
SMTP_PASSWORD=the-account-password

# Use STARTTLS? true/false
SMTP_USE_TLS=true

# Display name and from address in sent emails
FROM_EMAIL=otp-relay@company.com
FROM_NAME=OTP Relay

# ── Behaviour ─────────────────────────────────────────────────────────────────
# How long (seconds) a user's claim stays valid (default 300 = 5 minutes)
CLAIM_EXPIRY_SEC=300

# ── File paths ────────────────────────────────────────────────────────────────
USERS_EXCEL_PATH=data/users.xlsx
AUDIT_LOG_PATH=data/audit.log

# ── Monitor & Alerts ──────────────────────────────────────────────────────────
# WhatsApp alerts via CallMeBot (free, no account needed).
# Registration: send "I allow callmebot to send me messages" to +34 644 64 90 27
# on WhatsApp — you will receive your API key within minutes.
WHATSAPP_API_KEY=replace-with-callmebot-api-key
WHATSAPP_RECIPIENT=+971501234567

# Minimum log level that triggers a WhatsApp message.
# Options: info | warn | error   (default: error)
# Set to warn or info temporarily when live-troubleshooting.
ALERT_LEVEL=error

# Public URL of the portal — appended to every WhatsApp alert as a quick link.
PORTAL_URL=https://srvotp26.init-db.lan

# ── Phone watcher ─────────────────────────────────────────────────────────────
# Static IP of the company iPhone on the LAN (ask IT to set a DHCP reservation).
# Leave empty to disable phone monitoring.
PHONE_IP=192.168.1.x

# Network interface to use for ARP-based phone detection.
# Find yours with: ip link
PHONE_INTERFACE=ens33

# How often to ping the phone (seconds). Default: 300 (every 5 minutes).
PHONE_PING_INTERVAL=300

# How many consecutive failed pings before declaring the phone offline.
# Default: 2 (avoids false alarms from a single dropped packet).
PHONE_OFFLINE_THRESHOLD=2

# How long (seconds) to wait before sending a batched WhatsApp message.
# Events arriving within this window are grouped into one message.
# Default: 10
BATCH_WINDOW_SEC=10
