# OTP Relay — Environment Configuration
# Copy to .env and fill in your values.
# Never commit .env to git or share it.

# ── Security ──────────────────────────────────────────────────────────────────
# Random string — paste this exact value into your iPhone Shortcut header
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SMS_SECRET_TOKEN=e0ce08f1da23441e0121e91a2ef78fd263daba282a6e5896f79edaa441f408a4

# ── Exchange SMTP (ask IT for these) ──────────────────────────────────────────
# Internal Exchange server hostname or IP
SMTP_HOST=172.31.10.50

# 587 = STARTTLS (recommended), 25 = plain, 465 = SSL
SMTP_PORT=587

# The dedicated relay account IT will create for you
SMTP_USER=otp-relay@initse.com
SMTP_PASSWORD=Dubai@2026

# Use STARTTLS? true/false
SMTP_USE_TLS=true

# Display name and from address in sent emails
FROM_EMAIL=otp-relay@initse.com
FROM_NAME=OTP Relay

# ── Behaviour ─────────────────────────────────────────────────────────────────
# How long (seconds) a user's claim stays valid (default 300 = 5 minutes)
CLAIM_EXPIRY_SEC=300

# ── File paths ────────────────────────────────────────────────────────────────
USERS_EXCEL_PATH=data/users.xlsx
AUDIT_LOG_PATH=data/audit.log
