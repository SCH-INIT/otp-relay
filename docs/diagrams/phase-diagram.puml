@startuml otp-relay-k8s-phases

skinparam shadowing false
skinparam defaultTextAlignment center
skinparam nodesep 30
skinparam ranksep 40
skinparam padding 6
skinparam ArrowColor #6B7280
skinparam ArrowThickness 1.5
skinparam ArrowFontColor #6B7280
skinparam ArrowFontSize 11

skinparam rectangle {
  FontSize 12
  FontColor #1F2937
  BorderThickness 1
}

skinparam note {
  BackgroundColor #F9FAFB
  BorderColor #D1D5DB
  FontSize 11
  FontColor #6B7280
}

title OTP Relay → Kubernetes: phase map\n<size:11><color:#6B7280>one phase at a time, or so help us</color></size>

' ── PHASE 1 ───────────────────────────────────────────────────────────────────

package "Phase 1 — containerise and ship" as P1 #E1F5EE {

  note as P1note
    Run the existing app, exactly as-is, in K3s.
    No rewrites. No new state layer.
  end note

  rectangle "**Dockerfile**\nFastAPI + venv\n+ frontend\n1 worker" as P1_docker   #9FE1CB
  rectangle "**Deployment**\n1 replica\nprobes\nrolling update"  as P1_deploy   #9FE1CB
  rectangle "**ConfigMap**\n+ Secret\nenv vars\nno .env file"    as P1_config   #9FE1CB
  rectangle "**MetalLB**\nLAN-reachable\nIP on bare\nmetal K3s"  as P1_lb       #9FE1CB
  rectangle "**PVC**\nfor data/\naudit log\nusers.xlsx"          as P1_pvc      #D3D1C7

  P1_docker -[hidden]right-> P1_deploy
  P1_deploy -[hidden]right-> P1_config
  P1_config -[hidden]right-> P1_lb
  P1_lb    -[hidden]right-> P1_pvc
}

' ── PHASE 2 ───────────────────────────────────────────────────────────────────

package "Phase 2 — fix the stateful pain" as P2 #EEEDFE {

  note as P2note
    Scale to 2 replicas. Watch the queue break.
    Add Redis. Scale again. Now it works.
  end note

  rectangle "**2 replicas**\nqueue splits\nacross pods\nSMS hits wrong\none. chaos." as P2_break  #F5C4B3
  rectangle "**Redis**\nshared queue\nTTL per entry\nStatefulSet\n+ PVC"            as P2_redis  #AFA9EC
  rectangle "**2 replicas**\nqueue in Redis\nany pod can\nserve any SMS\nit works"  as P2_fixed  #9FE1CB

  P2_break -right-> P2_redis : add Redis
  P2_redis -right-> P2_fixed : scale again
}

' ── PHASE 3 ───────────────────────────────────────────────────────────────────

package "Phase 3 — resilience in one cluster" as P3 #FAEEDA {

  note as P3note
    Kill pods. Drain nodes. Watch it recover.
    Add monitoring so you know when it doesn't.
  end note

  rectangle "**Chaos**\nkill -9 pods\ndrain nodes\nwatch recovery"                   as P3_chaos   #FAC775
  rectangle "**Limits**\nrequests\n+ limits on\nall containers"                      as P3_limits  #FAC775
  rectangle "**PDB**\nPodDisruption\nBudget — never\nall down at once"               as P3_pdb     #FAC775
  rectangle "**Monitoring**\nPrometheus\n+ Grafana\nor k9s"                          as P3_mon     #FAC775

  P3_chaos  -[hidden]right-> P3_limits
  P3_limits -[hidden]right-> P3_pdb
  P3_pdb    -[hidden]right-> P3_mon
}

' ── PHASE 4 ───────────────────────────────────────────────────────────────────

package "Phase 4 — second data centre (optional, future-us problem)" as P4 #F1EFE8 {

  note as P4note
    By now you'll understand what this costs.
    Then decide if it's worth it.
  end note

  rectangle "**DC1 — active**\nK3s cluster\nRedis primary\napp pods"       as P4_dc1     #D3D1C7
  rectangle "**Failover runbook**\n+ DR tests\n+ restore tests"             as P4_runbook #D3D1C7
  rectangle "**DC2 — standby**\nK3s cluster\nRedis replica\napp pods (warm)" as P4_dc2   #D3D1C7

  P4_dc1 <-right-> P4_dc2 : streaming replication
  P4_dc1 -[hidden]right-> P4_runbook
  P4_runbook -[hidden]right-> P4_dc2
}

note bottom of P4
  active/active needs app redesign —
  active/standby with manual failover
  is probably enough for this workload
end note

' ── FLOW BETWEEN PHASES ───────────────────────────────────────────────────────

P1 -down-> P2 : break it on purpose
P2 -down-> P3 : now make it robust
P3 -down-> P4 : only if appetite remains

@enduml
