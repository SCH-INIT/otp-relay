diff --git a/k8s/manifests/service-otp-monitor.yaml b/k8s/manifests/service-otp-monitor.yaml
new file mode 100644
index 0000000..82d717f
--- /dev/null
+++ b/k8s/manifests/service-otp-monitor.yaml
@@ -0,0 +1,20 @@
+apiVersion: v1
+kind: Service
+metadata:
+  name: otp-monitor
+  namespace: otp-relay
+  labels:
+    app: otp-monitor
+spec:
+  type: ClusterIP
+  # The monitor pod uses hostNetwork: true, so port 9101 is bound on the
+  # node's interfaces directly. Kubernetes still resolves this Service via
+  # the pod's IP (which equals the node IP in hostNetwork mode), so the
+  # ServiceMonitor scrape works through the standard Service abstraction.
+  selector:
+    app: otp-monitor
+  ports:
+    - name: metrics
+      protocol: TCP
+      port: 9101
+      targetPort: 9101
diff --git a/k8s/observability/servicemonitor-otp-monitor.yaml b/k8s/observability/servicemonitor-otp-monitor.yaml
new file mode 100644
index 0000000..dd1c942
--- /dev/null
+++ b/k8s/observability/servicemonitor-otp-monitor.yaml
@@ -0,0 +1,19 @@
+apiVersion: monitoring.coreos.com/v1
+kind: ServiceMonitor
+metadata:
+  name: otp-monitor
+  namespace: observability
+  labels:
+    app: otp-monitor
+spec:
+  namespaceSelector:
+    matchNames:
+      - otp-relay
+  selector:
+    matchLabels:
+      app: otp-monitor
+  endpoints:
+    - port: metrics       # the named port on the otp-monitor Service
+      path: /metrics
+      interval: 15s
+      scrapeTimeout: 10s
