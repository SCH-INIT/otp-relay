# OTP Relay — secret environment variables
# Copy this file to secret.env and fill in the values.
# Do NOT commit secret.env to the repository.
#
# To apply to the cluster:
#   kubectl create secret generic otp-relay-secrets \
#     --namespace=otp-relay \
#     --from-literal=SMS_SECRET_TOKEN='...' \
#     --from-literal=TELEGRAM_BOT_TOKEN='...' \
#     --from-literal=TELEGRAM_CHAT_ID='...' \
#     --dry-run=client -o yaml | kubectl apply -f -

SMS_SECRET_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
